    Text: Rimuovi gli annunci obbligatori!
    Object: {fileID: 0}
  - Language: Japanese
    Text: "\u5FC5\u9808\u306E\u5E83\u544A\u3092\u524A\u9664\u3057\u3066\u304F\u3060\u3055\u3044\u3002"
    Object: {fileID: 0}
  - Language: Korean

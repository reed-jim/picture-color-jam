  m_EditorClassIdentifier: 
  data: 0
  entries:
  - Language: English
    Text: Enjoying the game? Please rate it to support us!
    Object: {fileID: 0}
  - Language: French
    Text: "Vous appr\xE9ciez le jeu ? "
    Object: {fileID: 0}
  - Language: German
    Text: "Hat Ihnen das Spiel Spa\xDF gemacht? "
    Object: {fileID: 0}
  - Language: Italian
    Text: 'Ti piace il gioco? '
    Object: {fileID: 0}
  - Language: Japanese
    Text: "\u30B2\u30FC\u30E0\u3092\u697D\u3057\u3093\u3067\u3044\u307E\u3059\u304B\uFF1F"
    Object: {fileID: 0}
  - Language: Korean
    Text: "\uAC8C\uC784\uC744 \uC990\uAE30\uACE0 \uC788\uB098\uC694? "
    Object: {fileID: 0}
  - Language: Portuguese
    Text: "Est\xE1 gostando do jogo? "
    Object: {fileID: 0}
  - Language: Russian
    Text: "\u041D\u0430\u0441\u043B\u0430\u0436\u0434\u0430\u0435\u0442\u0435\u0441\u044C
      \u0438\u0433\u0440\u043E\u0439? "
    Object: {fileID: 0}
  - Language: Spanish
    Text: "\xBFDisfrutando el juego? "
    Object: {fileID: 0}

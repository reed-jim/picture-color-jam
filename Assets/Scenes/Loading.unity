  m_Name: 
  m_EditorClassIdentifier: 
  data: 0
  entries:
  - Language: English
    Text: Moves only in the given direction!
    Object: {fileID: 0}
  - Language: French
    Text: "Ne bouge que dans la direction donn\xE9e!"
    Object: {fileID: 0}
  - Language: German
    Text: Bewegt sich nur in die gegebene Richtung!
    Object: {fileID: 0}
  - Language: Italian
    Text: Si muove solo nella direzione data!
    Object: {fileID: 0}
  - Language: Japanese
    Text: "\u4E0E\u3048\u3089\u308C\u305F\u65B9\u5411\u306B\u306E\u307F\u79FB\u52D5\u3057\u307E\u3059\uFF01"
    Object: {fileID: 0}
  - Language: Korean
    Text: "\uC8FC\uC5B4\uC9C4 \uBC29\uD5A5\uC73C\uB85C \uB9CC \uC6C0\uC9C1\uC785\uB2C8\uB2E4!"
    Object: {fileID: 0}
  - Language: Portuguese
    Text: "Move apenas na dire\xE7\xE3o dada!"
    Object: {fileID: 0}
  - Language: Russian
    Text: "\u0414\u0432\u0438\u0433\u0430\u0435\u0442\u0441\u044F \u0442\u043E\u043B\u044C\u043A\u043E
      \u0432 \u0434\u0430\u043D\u043D\u043E\u043C \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0438!"
    Object: {fileID: 0}
  - Language: Spanish
    Text: "\xA1Se mueve solo en la direcci\xF3n dada!"
    Object: {fileID: 0}

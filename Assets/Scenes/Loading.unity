--- !u!114 &821923324
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 821923322}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  data: 0
  entries:
  - Language: English
    Text: Select a color to clear all matching blocks
    Object: {fileID: 0}
  - Language: French
    Text: "S\xE9lectionnez une couleur pour effacer tous les blocs correspondants"
    Object: {fileID: 0}
  - Language: German
    Text: "W\xE4hlen Sie eine Farbe aus, um alle passenden Bl\xF6cke zu l\xF6schen"
    Object: {fileID: 0}
  - Language: Italian
    Text: Seleziona un colore per cancellare tutti i blocchi corrispondenti
    Object: {fileID: 0}
  - Language: Japanese
    Text: "\u8272\u3092\u9078\u629E\u3057\u3066\u3001\u3059\u3079\u3066\u306E\u30DE\u30C3\u30C1\u30F3\u30B0\u30D6\u30ED\u30C3\u30AF\u3092\u30AF\u30EA\u30A2\u3057\u307E\u3059"
    Object: {fileID: 0}
  - Language: Korean
    Text: "\uBAA8\uB4E0 \uC77C\uCE58\uD558\uB294 \uBE14\uB85D\uC744 \uC9C0\uC6B0\uB824\uBA74
      \uC0C9\uC0C1\uC744 \uC120\uD0DD\uD558\uC2ED\uC2DC\uC624"
    Object: {fileID: 0}
  - Language: Portuguese
    Text: Selecione uma cor para limpar todos os blocos correspondentes
    Object: {fileID: 0}
  - Language: Russian
    Text: "\u0412\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \u0446\u0432\u0435\u0442,
      \u0447\u0442\u043E\u0431\u044B \u043E\u0447\u0438\u0441\u0442\u0438\u0442\u044C
      \u0432\u0441\u0435 \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044E\u0449\u0438\u0435
      \u0431\u043B\u043E\u043A\u0438"
    Object: {fileID: 0}
  - Language: Spanish
    Text: Seleccione un color para borrar todos los bloques coincidentes
    Object: {fileID: 0}

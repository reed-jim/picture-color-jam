  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  data: 0
  entries:
  - Language: English
    Text: Swipe to rotate the object.
    Object: {fileID: 0}
  - Language: French
    Text: Faites glisser pour faire pivoter l'objet.
    Object: {fileID: 0}
  - Language: German
    Text: Wischen Sie, um das Objekt zu drehen.
    Object: {fileID: 0}
  - Language: Italian
    Text: Scorrere per ruotare l'oggetto.
    Object: {fileID: 0}
  - Language: Japanese
    Text: "\u30B9\u30EF\u30A4\u30D7\u3057\u3066\u30AA\u30D6\u30B8\u30A7\u30AF\u30C8\u3092\u56DE\u8EE2\u3057\u307E\u3059\u3002"
    Object: {fileID: 0}
  - Language: Korean
    Text: "\uAC1C\uCCB4\uB97C \uD68C\uC804\uD558\uB824\uBA74 \uC2A4\uC640\uC774\uD504\uD558\uC138\uC694."
    Object: {fileID: 0}
  - Language: Portuguese
    Text: Deslize para girar o objeto.
    Object: {fileID: 0}
  - Language: Russian
    Text: "\u041F\u0440\u043E\u0432\u0435\u0434\u0438\u0442\u0435 \u043F\u0430\u043B\u044C\u0446\u0435\u043C
      \u043F\u043E \u044D\u043A\u0440\u0430\u043D\u0443, \u0447\u0442\u043E\u0431\u044B
      \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u0442\u044C \u043E\u0431\u044A\u0435\u043A\u0442."
    Object: {fileID: 0}
  - Language: Spanish
    Text: Desliza para rotar el objeto.
    Object: {fileID: 0}

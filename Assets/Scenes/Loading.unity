  data: 0
  entries:
  - Language: English
    Text: Please check your internet connection
    Object: {fileID: 0}
  - Language: French
    Text: "Veuillez v\xE9rifier votre connexion Internet"
    Object: {fileID: 0}
  - Language: German
    Text: "Bitte \xFCberpr\xFCfen Sie Ihre Internetverbindung"
    Object: {fileID: 0}
  - Language: Italian
    Text: Controlla la tua connessione Internet
    Object: {fileID: 0}
  - Language: Japanese
    Text: "\u30A4\u30F3\u30BF\u30FC\u30CD\u30C3\u30C8\u63A5\u7D9A\u3092\u78BA\u8A8D\u3057\u3066\u304F\u3060\u3055\u3044"
    Object: {fileID: 0}
  - Language: Korean
    Text: "\uC778\uD130\uB137 \uC5F0\uACB0\uC744 \uD655\uC778\uD574\uC8FC\uC138\uC694"
    Object: {fileID: 0}
  - Language: Portuguese
    Text: "Verifique sua conex\xE3o com a Internet"
    Object: {fileID: 0}
  - Language: Russian
    Text: "\u041F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430, \u043F\u0440\u043E\u0432\u0435\u0440\u044C\u0442\u0435

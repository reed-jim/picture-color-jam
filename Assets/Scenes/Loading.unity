--- !u!114 &465617189
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 465617187}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: LeanLocalization::Lean.Localization.LeanPhrase
  data: 0
  entries:
  - Language: English
    Text: Are you sure you want to replay the level?
    Object: {fileID: 0}
  - Language: French
    Text: "\xCAtes-vous s\xFBr de vouloir rejouer le niveau\_?"
    Object: {fileID: 0}
  - Language: German
    Text: "Sind Sie sicher, dass Sie das Level noch einmal spielen m\xF6chten?"
    Object: {fileID: 0}
  - Language: Italian
    Text: Sei sicuro di voler rigiocare il livello?
    Object: {fileID: 0}
  - Language: Japanese
    Text: "\u30EC\u30D9\u30EB\u3092\u30EA\u30D7\u30EC\u30A4\u3057\u3066\u3082\u3088\u308D\u3057\u3044\u3067\u3059\u304B?"
    Object: {fileID: 0}
  - Language: Korean
    Text: "\uB808\uBCA8\uC744 \uB2E4\uC2DC \uD50C\uB808\uC774\uD558\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?"
    Object: {fileID: 0}
  - Language: Portuguese
    Text: "Tem certeza de que deseja repetir o n\xEDvel?"
    Object: {fileID: 0}
  - Language: Russian
    Text: "\u0412\u044B \u0443\u0432\u0435\u0440\u0435\u043D\u044B, \u0447\u0442\u043E
      \u0445\u043E\u0442\u0438\u0442\u0435 \u043F\u0435\u0440\u0435\u0438\u0433\u0440\u0430\u0442\u044C
      \u0443\u0440\u043E\u0432\u0435\u043D\u044C?"
    Object: {fileID: 0}
  - Language: Spanish
    Text: "\xBFEst\xE1s seguro de que quieres volver a jugar el nivel?"
    Object: {fileID: 0}
